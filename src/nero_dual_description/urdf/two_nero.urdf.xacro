<?xml version="1.0"?>
<!--
  two_nero.urdf.xacro

  Composes two AgileX Nero arms (via the nero_arm macro) as left/right
  "shoulders" on a simple torso. The torso is a box stand-in; replace
  it with your real mount geometry if you have meshes for it.

  Tuning: the properties at the top control torso size and where the
  shoulders sit. The shoulder rpy values rotate each arm's base so
  that it faces outward along ±Y (the "two shoulders" effect).
-->
<robot name="two_nero" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find nero_dual_description)/urdf/nero_arm_macro.xacro"/>

  <!-- ===== Mount geometry — set via launch args so there's one
       source of truth (the launch file) for both the URDF and the
       webapp's 3D rendering. ===== -->
  <xacro:arg name="torso_depth"       default="0.10"/>
  <xacro:arg name="torso_width"       default="0.22517"/>
  <xacro:arg name="torso_height"      default="0.60"/>
  <xacro:arg name="shoulder_tilt_deg" default="20.0"/>
  <xacro:property name="torso_depth"       value="$(arg torso_depth)"/>
  <xacro:property name="torso_width"       value="$(arg torso_width)"/>
  <xacro:property name="torso_height"      value="$(arg torso_height)"/>
  <xacro:property name="shoulder_tilt_deg" value="$(arg shoulder_tilt_deg)"/>
  <xacro:property name="shoulder_tilt"     value="${shoulder_tilt_deg * pi / 180.0}"/>
  <!-- World convention (matches the webapp's three.js scene and its
       axes-helper labels): +X = right, +Y = front, +Z = up. Lateral
       separation is along X, front-back along Y. -->
  <xacro:property name="shoulder_x_offset" value="${torso_width / 2.0}"/>
  <xacro:property name="shoulder_z"        value="${torso_height - 0.05}"/>

  <!-- Mount rotation must match main.js::buildArms() so the URDF's TF
       tree and the webapp's 3D scene describe the same physical
       orientation. main.js applies (intrinsic, in order):
         right: rotation.set(π, π/2, 0) then rotateX(+tilt)
                →  Rx(π) · Ry(π/2) · Rx(+tilt)
         left : rotation.y = -π/2     then rotateX(-tilt)
                →  Ry(-π/2) · Rx(-tilt)
       URDF rpy is extrinsic xyz (matrix = Rz(y)·Ry(p)·Rx(r)); the
       equivalent rpy triples that produce those matrices are:
         right: ( π + tilt, -π/2, 0 )
         left : (   -tilt , -π/2, 0 )
       Verified by multiplying out both forms at arbitrary tilt.
       Gravity in base_link is (-9.81, 0, 0) for both arms under this
       mount, matching the gravity_comp launch arg. -->
  <xacro:property name="right_shoulder_rpy" value="${ pi + shoulder_tilt} ${-pi / 2} 0"/>
  <xacro:property name="left_shoulder_rpy"  value="${    -shoulder_tilt} ${-pi / 2} 0"/>

  <!-- ===== World + torso ===== -->
  <link name="world"/>

  <link name="torso_base">
    <visual>
      <origin xyz="0 0 ${torso_height / 2}" rpy="0 0 0"/>
      <geometry>
        <box size="${torso_width} ${torso_depth} ${torso_height}"/>
      </geometry>
      <material name="torso_grey">
        <color rgba="0.35 0.38 0.42 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${torso_height / 2}" rpy="0 0 0"/>
      <geometry>
        <box size="${torso_width} ${torso_depth} ${torso_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${torso_height / 2}"/>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
  </link>

  <joint name="world_to_torso" type="fixed">
    <parent link="world"/>
    <child  link="torso_base"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Shoulder mount pads: empty anchor links at the rotated mount pose. -->
  <link name="left_shoulder_mount"/>
  <joint name="torso_to_left_shoulder" type="fixed">
    <parent link="torso_base"/>
    <child  link="left_shoulder_mount"/>
    <origin xyz="${-shoulder_x_offset} 0 ${shoulder_z}"
            rpy="${left_shoulder_rpy}"/>
  </joint>

  <link name="right_shoulder_mount"/>
  <joint name="torso_to_right_shoulder" type="fixed">
    <parent link="torso_base"/>
    <child  link="right_shoulder_mount"/>
    <origin xyz="${ shoulder_x_offset} 0 ${shoulder_z}"
            rpy="${right_shoulder_rpy}"/>
  </joint>

  <!-- ===== Two arm instances ===== -->
  <xacro:nero_arm prefix="left_" parent="left_shoulder_mount">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:nero_arm>

  <xacro:nero_arm prefix="right_" parent="right_shoulder_mount">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:nero_arm>

</robot>
