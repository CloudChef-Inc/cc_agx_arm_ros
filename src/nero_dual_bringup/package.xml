<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nero_dual_bringup</name>
  <version>0.1.0</version>
  <description>Dual-arm Nero bring-up: publishes composed URDF, launches both arm drivers under /left and /right, and starts the webapp.</description>
  <maintainer email="atish@cloudchef.io">atish</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>agx_arm_ctrl</exec_depend>
  <exec_depend>nero_dual_description</exec_depend>
  <exec_depend>nero_webapp</exec_depend>
  <exec_depend>agx_arm_moveit</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
